# ── Vercel serverless 版環境變數（.env.local 供本機；正式值在 Vercel 專案設定裡填）──
# 這份是範本，複製成 .env.local 再填真實值。.env / .env.local 已被 .gitignore 忽略，不會進版控。

# Turso / libSQL 資料庫連線
#   遠端 Turso：從 Turso 主控台或 `turso db show <name> --url` 取得
#   本機測試：可直接用本機檔案，不需要 token
#     TURSO_DATABASE_URL=file:./.verceltest/hunter.db
TURSO_DATABASE_URL=libsql://your-db-name-xxxx.turso.io

# Turso 資料庫存取 token（`turso db tokens create <name>` 取得）；file: 本機連線可留空
TURSO_AUTH_TOKEN=your-turso-auth-token

# JWT 簽章密鑰（玩家/管理員登入 token）。務必用一段夠長的隨機字串，不要用範例值。
#   產生方式範例：node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
